class Veiculo:
    def __init__(self, modelo, placa, valor_diaria):
        self.set_modelo(modelo)
        self.set_placa(placa)
        self.set_valor_diaria(valor_diaria)


    def get_modelo(self):
        return self.__modelo

    def get_placa(self):
        return self.__placa

    def get_valor_diaria(self):
        return self.__valor_diaria



    def set_modelo(self, modelo):
        if not isinstance(modelo, str) or not modelo.strip():
            raise ValueError("O modelo não pode ser vazio.")
        self.__modelo = modelo.strip()

    def set_placa(self, placa):
        if not isinstance(placa, str) or not placa.strip():
            raise ValueError("A placa não pode ser vazia.")
        self.__placa = placa.strip().upper()

    def set_valor_diaria(self, valor):
        if valor <= 0:
            raise ValueError("O valor da diária deve ser maior que zero.")
        self.__valor_diaria = valor


    def calcular_aluguel(self, dias):
        if dias <= 0:
            raise ValueError("A quantidade de dias deve ser maior que zero.")

        return self.__valor_diaria * dias

    def exibir_dados(self):
        print(f"Modelo: {self.get_modelo()}")
        print(f"Placa: {self.get_placa()}")
        print(f"Valor da diária: R$ {self.get_valor_diaria():.2f}")


class Carro(Veiculo):
    def __init__(self, modelo, placa, valor_diaria, portas):
        super().__init__(modelo, placa, valor_diaria)

        if portas <= 0:
            raise ValueError("A quantidade de portas deve ser maior que zero.")

        self.__portas = portas

    def get_portas(self):
        return self.__portas

    def calcular_aluguel(self, dias):
        # Valor base + taxa fixa de limpeza
        valor_base = super().calcular_aluguel(dias)
        taxa_limpeza = 50.00

        return valor_base + taxa_limpeza

    def exibir_dados(self):
        super().exibir_dados()
        print(f"Portas: {self.get_portas()}")
        print("Tipo: Carro")


class Moto(Veiculo):
    def __init__(self, modelo, placa, valor_diaria, cilindradas):
        super().__init__(modelo, placa, valor_diaria)

        if cilindradas <= 0:
            raise ValueError("As cilindradas devem ser maiores que zero.")

        self.__cilindradas = cilindradas

    def get_cilindradas(self):
        return self.__cilindradas

    def calcular_aluguel(self, dias):
        # Desconto de 10% sobre o valor base
        valor_base = super().calcular_aluguel(dias)
        desconto = 0.10

        return valor_base * (1 - desconto)

    def exibir_dados(self):
        super().exibir_dados()
        print(f"Cilindradas: {self.get_cilindradas()} cc")
        print("Tipo: Moto")



frota = []


def cadastrar_carro():
    try:
        print("\n--- CADASTRO DE CARRO ---")

        modelo = input("Digite o modelo: ")
        placa = input("Digite a placa: ")

        valor = float(input("Digite o valor da diária: "))

        if valor <= 0:
            raise ValueError("O valor da diária deve ser maior que zero.")

        portas = int(input("Digite a quantidade de portas: "))

        carro = Carro(modelo, placa, valor, portas)
        frota.append(carro)

    except ValueError as erro:
        print(f"\nErro no cadastro: {erro}")

    else:
        print("\nCarro cadastrado com sucesso!")

    finally:
        print("Operação de cadastro finalizada.")


def cadastrar_moto():
    try:
        print("\n--- CADASTRO DE MOTO ---")

        modelo = input("Digite o modelo: ")
        placa = input("Digite a placa: ")

        valor = float(input("Digite o valor da diária: "))

        if valor <= 0:
            raise ValueError("O valor da diária deve ser maior que zero.")

        cilindradas = int(input("Digite as cilindradas: "))

        moto = Moto(modelo, placa, valor, cilindradas)
        frota.append(moto)

    except ValueError as erro:
        print(f"\nErro no cadastro: {erro}")

    else:
        print("\nMoto cadastrada com sucesso!")

    finally:
        print("Operação de cadastro finalizada.")


def listar_veiculos():
    print("\n--- VEÍCULOS CADASTRADOS ---")

    if not frota:
        print("Nenhum veículo cadastrado.")
        return

    for indice, veiculo in enumerate(frota, start=1):
        print(f"\nVeículo {indice}")
        print("-" * 30)
        veiculo.exibir_dados()


def realizar_locacao():
    if not frota:
        print("\nNenhum veículo cadastrado para locação.")
        return

    listar_veiculos()

    try:
        escolha = int(input("\nDigite o número do veículo: "))

        if escolha < 1 or escolha > len(frota):
            raise IndexError("Veículo inexistente.")

        dias = int(input("Digite a quantidade de dias de aluguel: "))

        if dias <= 0:
            raise ValueError(
                "A quantidade de dias deve ser maior que zero."
            )

        veiculo = frota[escolha - 1]

        # POLIMORFISMO:
        # O Python chama automaticamente o calcular_aluguel()
        # correspondente ao tipo do objeto.
        valor_total = veiculo.calcular_aluguel(dias)

    except ValueError as erro:
        print(f"\nEntrada inválida: {erro}")

    except IndexError as erro:
        print(f"\nErro: {erro}")

    else:
        print("\n--- RESUMO DA LOCAÇÃO ---")
        print(f"Veículo: {veiculo.get_modelo()}")
        print(f"Placa: {veiculo.get_placa()}")
        print(f"Dias de aluguel: {dias}")
        print(f"Valor total: R$ {valor_total:.2f}")

    finally:
        print("Operação de locação finalizada.")


def menu():
    while True:
        print("\n")
        print("=" * 45)
        print("      SISTEMA DE GESTÃO DE FROTA")
        print("=" * 45)
        print("1 - Cadastrar Carro")
        print("2 - Cadastrar Moto")
        print("3 - Listar Veículos")
        print("4 - Realizar Locação")
        print("5 - Sair")
        print("=" * 45)

        try:
            opcao = int(input("Escolha uma opção: "))

        except ValueError:
            print("\nErro: digite apenas números de 1 a 5.")
            continue

        if opcao == 1:
            cadastrar_carro()

        elif opcao == 2:
            cadastrar_moto()

        elif opcao == 3:
            listar_veiculos()

        elif opcao == 4:
            realizar_locacao()

        elif opcao == 5:
            print("\nSistema encerrado. Obrigado!")
            break

        else:
            print("\nOpção inválida. Escolha uma opção de 1 a 5.")



      if __name__ == "__main__":
       menu()
